#9 puzzle 8----------------------------------------------------------------
start = [1, 2, 3,
         4, 0, 6,
         7, 5, 8]
goal = [1, 2, 3,
        4, 5, 6,
        7, 8, 0]
states = [start]
visited = [start]
while states:
    current = states.pop(0)
    if current == goal:
        print("Puzzle Solved!")
        print(current)
        break
    zero = current.index(0)
    row = zero // 3
    col = zero % 3
    moves = []
    if row > 0:
        moves.append(zero - 3)
    if row < 2:
        moves.append(zero + 3)
    if col > 0:
        moves.append(zero - 1)
    if col < 2:
        moves.append(zero + 1)
    for move in moves:
        new_state = current.copy()
        new_state[zero] = new_state[move]
        new_state[move] = 0
        if new_state not in visited:
            visited.append(new_state)
            states.append(new_state)
else:
    print("No solution")
#10 (8-queens problem)-----------------------------------------------------------
n = 8
board = [-1] * n
def safe(row, col):
    for i in range(row):
        if board[i] == col:
            return False
        if abs(board[i] - col) == abs(i - row):
            return False
    return True
def solve(row):
    if row == n:
        for i in range(n):
            for j in range(n):
                if board[i] == j:
                    print("Q", end=" ")
                else:
                    print(".", end=" ")
            print()
        print()
        return True
    for col in range(n):
        if safe(row, col):
            board[row] = col
            if solve(row + 1):
                return True
            board[row] = -1
    return False
solve(0)
