#3.TSP(travelling sales man problem)------------------------------
from itertools import permutations
graph = [
    [0, 10, 15, 20],
    [10, 0, 35, 25],
    [15, 35, 0, 30],
    [20, 25, 30, 0]
]
cities = [1, 2, 3]
min_cost = float('inf')
for path in permutations(cities):
    cost = 0
    current = 0
    for city in path:
        cost += graph[current][city]
        current = city
    cost += graph[current][0]
    if cost < min_cost:
        min_cost = cost
        best_path = path
print("\nMinimum Cost:", min_cost)
print("Best Path:", (0,) + best_path + (0,))

#4.A*Algorithm-----------------------------------------------------
graph = {
    'A': [('B', 1), ('C', 3)],
    'B': [('D', 3), ('E', 6)],
    'C': [('F', 5)],
    'D': [],
    'E': [('G', 2)],
    'F': [('G', 2)],
    'G': []
}
heuristic = {
    'A': 7,
    'B': 6,
    'C': 4,
    'D': 3,
    'E': 2,
    'F': 1,
    'G': 0
}
def astar(start, goal):
    open_list = [(start, 0)]
    visited = []
    while open_list:
        # Sort based on f = g + h
        open_list.sort(key=lambda x: x[1] + heuristic[x[0]])
        current, cost = open_list.pop(0)
        if current == goal:
            print("Goal Reached:", goal)
            return
        visited.append(current)
        for neighbour, weight in graph[current]:
            if neighbour not in visited:
                open_list.append((neighbour, cost + weight))
astar('A','G')

